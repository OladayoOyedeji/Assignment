(* File: lexer.mml *)

{#use "token.ml";;}

let digit = ['0'-'9']
let digits = digit+
let integer = '0' | (('-'|'+')?['1'-'9'] ['0'-'9']*)
let float = (integer ('e'|'E') integer) | (integer '.' digit*)
let string = '\"'_*'\"'
let plus = '+'
let minus = '-'
let mul = '*'
let exp = "**"
let div = '/'
let is_eq = "=="
let is_neq = "!="
let eq = "="
let if = "if"
let else = "else"
let lparen = '('
let rparen = ')'
let lcomment = "(*"
let rcomment = "*)"
let alpha = ['a'-'z']
let name = alpha+
let id_tok = ('_'+ alpha* digit*) | name (alpha* '_'* digit*)*
let indent = ['\n'] [' ']*
let space = [' ']*

rule lexer = parse
       indent as s
     {
       let n  = count_spaces s in
       (Indent_tok n)::(lexer lexbuf)
     }
     | lcomment
     {
        comment 1 lexbuf
     }
     | lparen
     {
        (Lparen_tok)::(lexer lexbuf)
     }
     | rparen
     {
        (Rparen_tok)::(lexer lexbuf)
     }
     | float as s
     {
        let f = float_of_string s in
        (Float_tok f)::(lexer lexbuf)
     }
     | string as s
     {
        (String_tok s)::(lexer lexbuf)
     }
     | integer as s
     {
        let i = int_of_string s in
        (Int_tok i)::(lexer lexbuf)
     }
     | plus
     {
        (Plus_tok)::(lexer lexbuf)
     }
     | minus
     {
        (Minus_tok)::(lexer lexbuf)
     }
     | exp
     {
        (Exp_tok)::(lexer lexbuf)
     }
     | mul
     {
        (Mul_tok)::(lexer lexbuf)
     }
     | div
     {
        (Div_tok)::(lexer lexbuf)
     }
     | if
     {
        (If_tok)::(lexer lexbuf)
     }
     | else
     {
        (Else_tok)::(lexer lexbuf)
     }
     | is_eq
     {
        (Is_Equ_tok)::(lexer lexbuf)
     }
     | is_neq
     {
        (Is_Neq_tok)::(lexer lexbuf)
     }
     | eq
     {
        (Equ_tok)::(lexer lexbuf)
     }
     | eof
     {
         []
     }
     | id_tok as s
     {
        (Id_tok s)::(lexer lexbuf)
     }
     | _ 
     {
        lexer lexbuf
     }
     and
     comment n = parse
       lcomment { comment (n+1) lexbuf }
     | rcomment {
                        if n = 1 then
                           lexer lexbuf
                        else
                           comment (n-1) lexbuf
                     }
     | _             { comment n lexbuf }
{
let tokenize s = lexer (Lexing.from_string s);;
}
